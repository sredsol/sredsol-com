---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../../config/site.config";
import { footerNav } from "../../config/nav.config";
import { t } from "../../i18n/ui";
import { resolveRoute } from "../../i18n/routes";
import type { Locale } from "../../lib/site-config";
import Logo from "./Logo.astro";
import { SystemMark } from "../ui/data-display";

export interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props as Props;
const year = new Date().getFullYear();

const socialIcon = (url: string) => {
  if (url.includes("github.com")) return "lucide:github";
  if (url.includes("twitter.com") || url.includes("x.com"))
    return "lucide:twitter";
  if (url.includes("linkedin.com")) return "lucide:linkedin";
  if (url.includes("/lab")) return "lucide:flask-conical";
  if (url.startsWith("mailto:")) return "lucide:mail";
  return "lucide:link";
};
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo />
        <p class="footer__tagline">{t(currentLocale, "footer.tagline")}</p>
        <SystemMark size="sm" align="left" class="my-2" />
        
        <div class="footer__status" aria-label="System status">
          <span class="footer__status-dot" aria-hidden="true"></span>
          <span class="footer__status-text">{t(currentLocale, "footer.statusOperational")}</span>
        </div>
      </div>

      <div class="footer__column">
        <h2>{t(currentLocale, "footer.explorations")}</h2>
        <ul>
          {
            footerNav.explorations.map((item) => (
              <li>
                <a href={resolveRoute(currentLocale, item.href)}>
                  {t(currentLocale, item.labelKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__column">
        <h2>{t(currentLocale, "footer.company")}</h2>
        <ul>
          {
            footerNav.company.map((item) => (
              <li>
                <a href={resolveRoute(currentLocale, item.href)}>
                  {t(currentLocale, item.labelKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__column">
        <h2>{t(currentLocale, "footer.ecosystem")}</h2>
        <ul class="footer__social">
          {
            footerNav.social.map((link) => (
              <li>
                <a
                  href={link.href.startsWith("http") ? link.href : resolveRoute(currentLocale, link.href)}
                  target={link.href.startsWith("http") ? "_blank" : undefined}
                  rel={link.href.startsWith("http") ? "noreferrer" : undefined}
                >
                  <Icon name={socialIcon(link.href)} />
                  <span>{t(currentLocale, link.labelKey)}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="footer__meta">
      <p class="footer__copyright">&copy; {year} {siteConfig.name}. {t(currentLocale, "footer.rights")}</p>
      <div class="footer__legal">
        {
          footerNav.legal.map((item) => (
            <a href={resolveRoute(currentLocale, item.href)}>
              {t(currentLocale, item.labelKey)}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
  }

  .footer__inner {
    padding-block: var(--space-2xl) var(--space-lg);
  }

  .footer__grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1.5fr repeat(3, minmax(0, 1fr));
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer__tagline {
    margin: var(--space-md) 0 0;
    color: var(--color-text-secondary);
    line-height: 1.6;
    font-size: 0.9375rem;
    max-width: 22rem;
  }

  .footer__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-lg);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-bg-primary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .footer__status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--success);
    box-shadow: 0 0 8px color-mix(in srgb, var(--success) 60%, transparent);
  }

  .footer__column h2 {
    margin: 0 0 var(--space-sm);
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-primary);
  }

  .footer__column ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .footer__column a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.15s ease;
  }

  .footer__column a:hover,
  .footer__social a:hover {
    color: var(--color-brand-primary);
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.15s ease;
  }

  .footer__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }

  .footer__copyright {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    margin: 0;
  }

  .footer__legal {
    display: flex;
    gap: var(--space-lg);
  }

  .footer__legal a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer__legal a:hover {
    color: var(--color-brand-primary);
  }

  @media (max-width: 60rem) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 40rem) {
    .footer__grid,
    .footer__meta {
      grid-template-columns: 1fr;
      display: grid;
    }
  }
</style>

