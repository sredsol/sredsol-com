---
import { cn } from "../../lib/cn";
import { SystemMark } from "../ui/data-display";

export interface Props {
  locale?: string;
  class?: string;
}

const { class: className } = Astro.props as Props;

const conduitSteps = [
  { label: "Mathematical Model", symbol: "∑", detail: "Formal equations & dynamical systems" },
  { label: "Computational System", symbol: "λ", detail: "High-throughput execution kernels" },
  { label: "Interactive Environment", symbol: "◈", detail: "Direct manipulation instruments" },
  { label: "Physical Experiment", symbol: "⚡", detail: "Hardware telemetry & sensor bridges" },
  { label: "Empirical Observation", symbol: "◎", detail: "Multi-spectral calibration & synthesis" },
];
---

<section class={cn("editorial-manifesto-section", className)} id="manifesto">
  <div class="editorial-manifesto-section__bg-grid" aria-hidden="true"></div>

  <div class="container editorial-manifesto-container">
    <div class="editorial-manifesto-header">
      <SystemMark size="md" align="center" class="editorial-manifesto-mark" />
      <p class="editorial-manifesto-eyebrow">00 // THE RESEARCH CONDUIT</p>
      <blockquote class="editorial-manifesto-quote">
        “We move from models to systems, and from systems to observation.”
      </blockquote>
      <p class="editorial-manifesto-subtext">
        Computational models remain hypotheses until they interface with physical sensors, real-time instruments, and interactive cognitive spaces.
      </p>
    </div>

    <div class="editorial-manifesto-conduit" aria-label="Transformation sequence from model to observation">
      <div class="conduit-track" aria-hidden="true">
        <div class="conduit-pulse"></div>
      </div>

      <div class="conduit-steps">
        {
          conduitSteps.map((step, index) => (
            <div class="conduit-step">
              <div class="conduit-node">
                <span class="conduit-node__symbol" aria-hidden="true">{step.symbol}</span>
                <span class="conduit-node__ring" aria-hidden="true"></span>
              </div>
              <div class="conduit-content">
                <div class="conduit-content__header">
                  <span class="conduit-content__index">0{index + 1}</span>
                  <h3 class="conduit-content__label">{step.label}</h3>
                </div>
                <p class="conduit-content__detail">{step.detail}</p>
              </div>
              {index < conduitSteps.length - 1 && (
                <div class="conduit-connector" aria-hidden="true">
                  <span class="conduit-connector__arrow">&darr;</span>
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .editorial-manifesto-section {
    position: relative;
    padding: var(--space-3xl) 0;
    background: var(--background);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .editorial-manifesto-section__bg-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, color-mix(in srgb, var(--foreground) 7%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    opacity: 0.6;
    pointer-events: none;
  }

  .editorial-manifesto-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .editorial-manifesto-header {
    max-width: 52rem;
    margin: 0 auto var(--space-2xl);
  }

  .editorial-manifesto-mark {
    margin-bottom: var(--space-md);
  }

  .editorial-manifesto-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.16em;
    color: var(--color-brand-primary);
    text-transform: uppercase;
    margin-bottom: var(--space-md);
  }

  .editorial-manifesto-quote {
    margin: 0 0 var(--space-lg);
    font-family: var(--font-heading);
    font-size: clamp(1.65rem, 3.5vw, 2.75rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--foreground);
  }

  .editorial-manifesto-subtext {
    max-width: 40rem;
    margin: 0 auto;
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--muted-foreground);
  }

  /* Conduit Pipeline */
  .editorial-manifesto-conduit {
    position: relative;
    width: 100%;
    max-width: 58rem;
    margin-top: var(--space-lg);
  }

  .conduit-track {
    display: none;
  }

  .conduit-steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-md);
    position: relative;
  }

  .conduit-step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-lg) var(--space-sm);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .conduit-step:hover {
    border-color: var(--color-brand-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .conduit-node {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: var(--color-bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-md);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .conduit-step:hover .conduit-node {
    border-color: var(--color-brand-primary);
    transform: scale(1.08);
  }

  .conduit-node__symbol {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-brand-primary);
  }

  .conduit-node__ring {
    position: absolute;
    inset: -3px;
    border-radius: var(--radius-full);
    border: 1px dashed color-mix(in srgb, var(--color-brand-primary) 30%, transparent);
    opacity: 0.6;
    animation: ring-rotate 16s linear infinite;
  }

  .conduit-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }

  .conduit-content__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    margin-bottom: 0.35rem;
  }

  .conduit-content__index {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted-foreground);
    letter-spacing: 0.08em;
  }

  .conduit-content__label {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: var(--font-weight-bold);
    color: var(--foreground);
    margin: 0;
    line-height: 1.35;
  }

  .conduit-content__detail {
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--muted-foreground);
    margin: 0.25rem 0 0;
  }

  .conduit-connector {
    display: none;
  }

  @keyframes ring-rotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* Responsive layout for tablets & mobile */
  @media (max-width: 64rem) {
    .conduit-steps {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      max-width: 28rem;
      margin: 0 auto;
    }

    .conduit-step {
      flex-direction: row;
      text-align: left;
      padding: var(--space-md) var(--space-lg);
      gap: var(--space-md);
    }

    .conduit-node {
      margin-bottom: 0;
      flex-shrink: 0;
    }

    .conduit-content {
      align-items: flex-start;
    }

    .conduit-content__header {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-xs);
    }

    .conduit-connector {
      display: block;
      position: absolute;
      bottom: -1rem;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--font-mono);
      font-size: 0.875rem;
      color: var(--muted-foreground);
      z-index: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .conduit-node__ring {
      animation: none;
    }
    .conduit-step,
    .conduit-node {
      transition: none;
      transform: none;
    }
  }
</style>
