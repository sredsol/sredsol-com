---
import { cn } from "../../lib/cn";
import { Badge } from "../ui/data-display";
import { Button } from "../ui/form";
import { getAllPosts } from "../../lib/cms";
import { calcReadingTime } from "../../lib/utils";

export interface Props {
  limit?: number;
  locale?: string;
  class?: string;
  showHeader?: boolean;
  title?: string;
  eyebrow?: string;
  lead?: string;
  showViewAll?: boolean;
}

const {
  limit = 3,
  showHeader = true,
  showViewAll = false,
  title = "Thinking",
  eyebrow = "RESEARCH & ESSAYS",
  lead = "Notes from the frontier of computational systems, physical hardware bridges, and cognitive tools.",
  class: className,
} = Astro.props as Props;

const posts = await getAllPosts();
const thinkingArticles = posts.map((post) => {
  const domainTag = post.data.tags?.[0] || "EXPLORATION";
  return {
    slug: post.id,
    title: post.data.title,
    domain: domainTag.toLowerCase(),
    domainLabel: domainTag,
    description: post.data.description,
    date: post.data.publishDate.toISOString().split("T")[0],
    readTime: `${calcReadingTime(post.body || "").minutes} min read`,
    author: post.data.author || "SREDSOL Research",
    href: `/thinking/${post.id}`,
  };
});

const displayedArticles = limit ? thinkingArticles.slice(0, limit) : thinkingArticles;
---

<section class={cn("thinking-digest-section py-20", className)} id="thinking">
  <div class="container">
    {
      showHeader && (
        <header class="section-head">
          <p class="section-head__eyebrow">{eyebrow}</p>
          <h2 class="section-head__title">{title}</h2>
          <p class="section-head__lead">{lead}</p>
        </header>
      )
    }

    <div class={cn("thinking-grid", !showHeader && "mt-0")}>
      {
        displayedArticles.map((article) => (
          <article class="thinking-card">
            <header class="thinking-card__header">
              <div class="thinking-card__meta">
                <Badge variant="outline" size="sm">{article.domainLabel}</Badge>
                <span class="thinking-card__read-time">{article.readTime}</span>
              </div>
              <h3 class="thinking-card__title">
                <a href={article.href} class="thinking-card__link">
                  {article.title}
                </a>
              </h3>
            </header>

            <p class="thinking-card__description">{article.description}</p>

            <footer class="thinking-card__footer">
              <span class="thinking-card__author">{article.author}</span>
              <a href={article.href} class="thinking-card__action">
                <span>Read essay</span>
                <span class="thinking-card__arrow" aria-hidden="true">&rarr;</span>
              </a>
            </footer>
          </article>
        ))
      }
    </div>

    {
      showViewAll && (
        <div class="thinking-digest-section__action">
          <Button variant="secondary" size="lg" href="/thinking">
            <span>Read All Research Notes</span>
            <span aria-hidden="true">&rarr;</span>
          </Button>
        </div>
      )
    }
  </div>
</section>

<style>
  .thinking-digest-section {
    position: relative;
    border-bottom: 1px solid var(--border);
  }

  .thinking-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-xl);
    margin-top: var(--space-2xl);
  }

  .thinking-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-xl);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--card);
    transition: all var(--duration-fast) var(--ease-default);
  }

  .thinking-card:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .thinking-card__header {
    margin-bottom: var(--space-md);
  }

  .thinking-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .thinking-card__read-time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  .thinking-card__title {
    margin: 0;
    font-size: 1.25rem;
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .thinking-card__link {
    color: var(--foreground);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-default);
  }

  .thinking-card__link:hover {
    color: var(--primary);
  }

  .thinking-card__description {
    margin: 0 0 var(--space-xl);
    font-size: 0.9375rem;
    color: var(--muted-foreground);
    line-height: 1.6;
    flex-grow: 1;
  }

  .thinking-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .thinking-card__author {
    color: var(--muted-foreground);
  }

  .thinking-card__action {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
    transition: gap var(--duration-fast) var(--ease-default);
  }

  .thinking-card__action:hover {
    gap: 0.5rem;
  }

  .thinking-card__arrow {
    display: inline-block;
  }

  .thinking-digest-section__action {
    display: flex;
    justify-content: center;
    margin-top: var(--space-2xl);
  }

  @media (prefers-reduced-motion: reduce) {
    .thinking-card {
      transition: none;
    }
    .thinking-card:hover {
      transform: none;
    }
    .thinking-card__action {
      transition: none;
    }
  }
</style>
