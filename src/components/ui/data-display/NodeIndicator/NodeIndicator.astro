---
import { cn } from "../../../../lib/cn";

export interface Props {
  label: string;
  code?: string;
  domain?: "computation" | "physical" | "observation" | "learning";
  status?: "active" | "lab" | "streaming" | "idle";
  size?: "sm" | "md" | "lg";
  interactive?: boolean;
  class?: string;
}

const {
  label,
  code,
  domain = "computation",
  status = "active",
  size = "md",
  interactive = false,
  class: className,
} = Astro.props as Props;

const statusDotClass = {
  active: "node-indicator__status--active",
  lab: "node-indicator__status--lab",
  streaming: "node-indicator__status--streaming",
  idle: "node-indicator__status--idle",
}[status];
---

<div
  class={cn(
    "node-indicator",
    `node-indicator--${size}`,
    `node-indicator--${domain}`,
    interactive && "node-indicator--interactive",
    className,
  )}
>
  <span class={cn("node-indicator__status", statusDotClass)} aria-hidden="true"></span>
  {code && <span class="node-indicator__code">{code}</span>}
  <span class="node-indicator__label">{label}</span>
  <slot />
</div>

<style>
  .node-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--foreground);
    font-size: 0.8125rem;
    font-weight: 600;
    box-shadow: var(--shadow-sm);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .node-indicator--sm {
    padding: 0.2rem 0.55rem;
    font-size: 0.75rem;
    gap: 0.35rem;
  }

  .node-indicator--lg {
    padding: 0.5rem 1rem;
    font-size: 0.9375rem;
    gap: 0.65rem;
  }

  .node-indicator__status {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .node-indicator__status--active {
    background: var(--success);
    box-shadow: 0 0 6px color-mix(in srgb, var(--success) 60%, transparent);
  }

  .node-indicator__status--lab {
    background: var(--warning);
    box-shadow: 0 0 6px color-mix(in srgb, var(--warning) 60%, transparent);
  }

  .node-indicator__status--streaming {
    background: var(--info);
    box-shadow: 0 0 6px color-mix(in srgb, var(--info) 60%, transparent);
    animation: telemetry-pulse 2s infinite ease-in-out;
  }

  .node-indicator__status--idle {
    background: var(--muted-foreground);
  }

  .node-indicator__code {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted-foreground);
    letter-spacing: 0.05em;
  }

  .node-indicator__label {
    white-space: nowrap;
  }

  .node-indicator--interactive {
    cursor: pointer;
  }

  .node-indicator--interactive:hover {
    border-color: var(--primary);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .node-indicator--interactive:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .node-indicator,
    .node-indicator__status--streaming {
      animation: none;
      transition: none;
      transform: none;
    }
  }
</style>
