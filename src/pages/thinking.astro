---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { GridBackground } from "../components/ui/layout";
import { NodeIndicator } from "../components/ui/data-display";
import { ThinkingDigest, LabCTA } from "../components/sections";
import { siteConfig } from "../config/site.config";

const locale = (Astro.currentLocale || "en") as "en";
---

<MarketingLayout
  title={`Thinking & Research — ${siteConfig.name}`}
  description="Research notes, technical essays, and architecture logs from SREDSOL."
  locale={locale}
  path="/thinking"
>
  <!-- Page Header -->
  <section class="page-header py-16">
    <GridBackground variant="crosshairs" glow glowPosition="top" mask="radial" />
    <div class="container">
      <div class="page-header__meta">
        <NodeIndicator label="RESEARCH & WRITING // THINKING" code="PUB-01" status="active" size="sm" />
      </div>
      <h1 class="page-header__title">Thinking</h1>
      <p class="page-header__lead">
        Essays on computational learning, physical computing architectures, scientific observation, and cognitive tools.
      </p>
    </div>
  </section>

  <!-- Full Thinking Digest -->
  <ThinkingDigest limit={12} showHeader={false} locale={locale} />

  <LabCTA locale={locale} />

</MarketingLayout>

<style>
  .page-header {
    position: relative;
    border-bottom: 1px solid var(--border);
    text-align: center;
  }

  .page-header__meta {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-md);
  }

  .page-header__title {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-family: var(--font-heading);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--foreground);
  }

  .page-header__lead {
    margin: var(--space-md) auto 0;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: var(--muted-foreground);
    line-height: 1.6;
    max-width: 38rem;
  }
</style>
